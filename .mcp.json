{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "pull_requests,actions,repos"
      }
    },
    "linear-server": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": ["node_modules/@playwright/mcp/cli.js", "--output-dir", ".playwright-mcp"]
    },
    "shadcn": {
      "type": "stdio",
      "command": "node",
      "args": ["node_modules/shadcn/dist/index.js", "mcp", "--cwd", "packages/ui"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--isolated"
      ]
    },
    "fal-ai": {
      "type": "http",
      "url": "https://mcp.fal.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${FAL_KEY}"
      }
    }
  }
}
