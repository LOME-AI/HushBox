{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The skill tree's own `node:test` files, which no package's `test` task
    // can reach: `.claude/skills` matches no workspace glob, so it is outside
    // every vitest project, every ESLint config and every tsconfig. Declared
    // here rather than in the root config because only this package runs it —
    // a root declaration materializes the task for every workspace, and each
    // one then hashes its own tree on every invocation to do nothing.
    //
    // The whole skill tree is the input rather than its test files alone,
    // because a test there reads sibling modules and fixtures as readily as it
    // imports them, and an input set narrowed to what today's tests happen to
    // touch replays a green over an edit to what tomorrow's touch. The one
    // exclusion is the hash the skills build writes: it is gitignored, a
    // filesystem glob is not gitignore-aware, and unnamed it would move this
    // task's hash on every regeneration.
    //
    // `pnpm-lock.yaml` because a skill test resolves its imports out of the
    // repository's own `node_modules` — deprived of them the static-html engine
    // falls back to regex and the same sources produce a different verdict, so
    // the installed dependencies are part of what this task measures.
    "test:skills": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/skills/**",
        "!$TURBO_ROOT$/.claude/skills/.cache/**",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "outputs": []
    }
  }
}
