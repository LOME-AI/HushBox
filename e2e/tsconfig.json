{
  "extends": "../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": true,
    // The package's `eslint.config.js` carries `// @ts-check`; these are what
    // make that pragma true rather than decorative. `allowImportingTsExtensions`
    // is required because the shared config it imports reaches a `.ts` module by
    // its real extension, and nothing here emits.
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  // The claims declaration is reached because the banner-row lock imports the
  // claim primitive, which imports a package that ships no types; the ambient
  // declaration for it sits beside that primitive and only a program including
  // it can see it.
  "include": [
    "../packages/config/types/*.d.ts",
    "../scripts/lib/claims/*.d.ts",
    "eslint.config.js",
    "**/*.ts"
  ]
}
