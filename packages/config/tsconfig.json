{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": true,
    "types": ["node"],
    // The vendored lint rules and the flat config are JavaScript carrying
    // `// @ts-check`, which asserts nothing unless a project includes the file.
    // These are what make that pragma true for this package rather than
    // decorative.
    "allowJs": true,
    "checkJs": true,
    // `eslint.config.js` imports the test-file spelling module by its `.ts`
    // path; nothing here emits, so the extension is legal to resolve.
    "allowImportingTsExtensions": true
  },
  "include": [
    "arch/**/*.ts",
    "test-file-spellings.ts",
    "vitest.config.ts",
    "vitest.package.config.ts",
    "types/**/*.d.ts",
    // A file specification cannot end in `**` — the compiler refuses it
    // (TS5010), so each tree is named down to its files.
    "eslint.config.js",
    "eslint-extensions/**/*",
    "eslint-parts/**/*"
  ],
  // Every fixture tree holds source written to be wrong for the rule that reads
  // it, so none of it is checkable.
  "exclude": ["node_modules", "dist", "**/__test-fixtures-*__"]
}
