{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    // Nothing here sets an output directory, so emit lands each artifact beside the source
    // it came from; what the project reaches through `node_modules` is read and not emitted
    // for, but a test reaches out of the package by relative path, so the litter also lands
    // in another workspace. The `typecheck` script's `--noEmit` cannot bind an ad-hoc run.
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
