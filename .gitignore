# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
# apps/web emits one sibling dist per mobile OTA target from the same vite config
# (ci.yml builds `--outDir dist-$platform`); the glob covers targets not yet added.
dist-*/
build/
out/
.next/
.vercel/
.wrangler/
apps/api/.wrangler-*.log
.astro/

# TypeScript
*.tsbuildinfo

# Turbo
.turbo/

# Environment files (auto-generated by pnpm generate:env): three per stack, plus
# one for the mode that runs no stack. That last can hold live secrets, and
# without its own entry no pattern in this file reaches it — `.env.*.local`
# looks like it would and does not.
.env
.env.local
.env.*.local
.env.development
.env.e2e
.env.test
.env.production
.env.scripts
.env.scripts.e2e
.env.scripts.test
.dev.vars
.dev.vars.e2e
.dev.vars.test

# Test fixtures (generated by vitest, cleaned up in afterEach)
# The `__test-fixtures-*__` name is for those generated ones. Absent a `!` rule
# re-including it, a file under the generated name is silently untracked, showing in
# neither `git status` nor a fresh clone, so name a fixture directory meant to be
# committed `test-fixtures/`, which no rule here matches.
**/__test-fixtures-*__/
# packages/config fixture corpora are committed lint-rule inputs, not generated
!packages/config/**/__test-fixtures-*__/
# the binary stripper's container specimens are hand-built source, not generated
!scripts/lib/__test-fixtures-binary-strip__/

# Test coverage
coverage/
cov-tmp/
coverage-scoped*/
coverage-*/
.nyc_output/

# HTTP cassettes for AI Gateway integration tests (recorded by CI, restored
# from the shared cassette store; never committed). See docs/CI-CASSETTES.md.
.ai-cassettes/

# Quality reports
/reports/
.stryker-cache/
.stryker-tmp/

# Playwright
playwright-report/
test-results/
# e2e-clean.ts renames a wedged output dir aside as test-results.purge-<n> before each run
test-results.purge-*/
# Playwright MCP scratch output (screenshots, snapshots)
.playwright-mcp/
# Chrome DevTools MCP scratch output (screenshots)
.chrome-devtools-mcp/
e2e/.auth/
e2e/report/

# Maestro
maestro-results/

# Logs
*.log
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
/.idea
.vscode/
*.swp
*.swo

# Claude Code
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Local overrides
*.local*
/*Local

# Capacitor
apps/web/ios/App/Pods/
apps/web/android/.gradle/
apps/web/android/app/build/
apps/web/public/dev-assets/

# Temporary files
*.tmp
*.temp
.cache/
# README generation hashes are deliberately committed so CI and fresh clones
# skip expensive regeneration when inputs haven't changed.
!.github/readme/.cache/
# scripts/.cache/seed-crypto.json is committed: a single fingerprint-keyed map of
# OPAQUE seed fixtures. The live seed reuses it on a hit and rewrites it wholesale
# on a miss; it is committed so CI and matching-secret devs get clean hits, and it
# self-invalidates (the whole file is rewritten) when packages/crypto changes the
# crypto fingerprint or CACHE_VERSION bumps. Only this file is re-included —
# everything else under scripts/.cache/ (per-slot deps hashes and lock files) is
# runtime churn and stays ignored.
!scripts/.cache/
scripts/.cache/*
!scripts/.cache/seed-crypto.json
# Local dev-stack runtime state (deps hashes, lock files); per-machine, never committed.
scripts/.cache/local/

# Crash residue from a killed finding-file writer; the next writer reclaims it, so this is
# commit hygiene rather than correctness.
docs/audits/**/*.md.lock
docs/audits/**/*.md.*.tmp

# TanStack Router
.tanstack/

# Filesystem
.fuse*

# BEGIN records overlay — tracked by .records.git (pnpm records), never by this repository
docs/runs/
docs/history/
docs/audits/*/
/.records.git/
# END records overlay
