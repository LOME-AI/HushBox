       if (newItem) {
-        setTimeout(() => newItem.focus());
+        // HushBox patch: upstream moves focus here in `setTimeout`, so a key event
+        // handled before that timer fires acts on the item focus is leaving: in a menu of Pin,
+        // Mute, Rename and Delete, "r" then Enter chose Pin. This patch moves focus in a
+        // microtask instead, which runs before the next key event is handled. Source:
+        // packages/react/menu/src/menu.tsx line 419 at @radix-ui/react-menu 2.1.17
+        // (https://github.com/radix-ui/primitives).
+        // No upstream issue tracks this timer; https://github.com/radix-ui/primitives/pull/4108
+        // makes the same change in @radix-ui/react-roving-focus.
+        // Remove this patch once a released @radix-ui/react-menu moves this focus in a microtask
+        // or synchronously. The packages/ui dropdown-menu test "chooses the item typeahead
+        // reached when Enter arrives before a timer turn" fails whenever this patch is not
+        // applied.
+        queueMicrotask(() => newItem.focus());
       }
     };
     React.useEffect(() => {
