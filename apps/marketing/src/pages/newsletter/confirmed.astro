---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { NewsletterConfirmed } from '../../components/newsletter/NewsletterConfirmed';

// The wall decodes these while the confirm request runs; the island then
// reveals the literal headline in the hero's exclusion zone.
const CONFIRMED_CIPHER_MESSAGES: readonly string[] = [
  'You Are On The List',
  'Consider It Confirmed',
  'A Few Letters a Year',
  'Written by Humans',
  'See You In Your Inbox',
  'Leave Any Time',
];
---

<SiteLayout title="Confirm your subscription" description="Newsletter subscription confirmation.">
  <div class="flex-1">
    <PageHero messages={CONFIRMED_CIPHER_MESSAGES} fullscreen>
      <NewsletterConfirmed client:load />
    </PageHero>
  </div>
</SiteLayout>
