---
import { Text } from '@hushbox/ui/type';
import SectionHeading from '../SectionHeading.astro';
import { MESSAGES_PER_DAY } from '../../lib/calculate-cost';
import { CostFigures } from './CostFigures';
import { ProviderStrip } from './ProviderStrip';
import WelcomeSection from './WelcomeSection.astro';
---

<WelcomeSection reveal>
  <SectionHeading>Same models. A fraction of the cost</SectionHeading>
  <div class="text-foreground mt-3 text-center">
    <Text variant="ui">Based on {MESSAGES_PER_DAY} messages per day:</Text>
  </div>
  <div class="mt-12">
    <CostFigures client:load />
  </div>
  <p class="text-foreground mt-6 text-center font-serif text-sm">
    HushBox hates subscriptions. You only pay for what you use. Nothing more.
  </p>
  <div class="border-border mt-16 rounded-lg border-2 p-6" data-reveal="delayed">
    <ProviderStrip client:load />
  </div>
</WelcomeSection>
