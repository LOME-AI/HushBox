---
interface Props {
  hushboxCost: number;
  modelCount: number;
}

const { hushboxCost, modelCount } = Astro.props;
const formattedCost = hushboxCost.toFixed(2);

const competitors = [
  { name: 'ChatGPT Plus', price: 20, note: 'GPT only' },
  { name: 'Claude Pro', price: 20, note: 'Claude only' },
  { name: 'Gemini Advanced', price: 20, note: 'Gemini only' },
];
---

<div class="@container flex flex-col gap-4" data-cost-list>
  {
    competitors.map((c) => (
      <div
        class="@max-mkt-cost-stack:flex-wrap @max-mkt-cost-stack:gap-1.5 flex items-center gap-4"
        data-cost-row
      >
        <div
          class="@max-mkt-cost-stack:w-full w-[clamp(7rem,5.6rem+3vw,9rem)] shrink-0 text-sm font-medium"
          data-cost-name
        >
          {c.name}
        </div>
        <div
          class="bg-muted/40 relative flex min-h-8 flex-1 items-center justify-end overflow-hidden rounded-md"
          data-cost-track
        >
          <div class="bg-foreground-muted/20 absolute inset-y-0 left-0 w-full" data-cost-fill />
          <div class="text-foreground relative py-1 pr-3 text-right text-xs" data-cost-value>
            ${c.price}/mo · {c.note}
          </div>
        </div>
      </div>
    ))
  }

  <div
    class="@max-mkt-cost-stack:flex-wrap @max-mkt-cost-stack:gap-1.5 flex items-center gap-4"
    data-cost-row
  >
    <div
      class="@max-mkt-cost-stack:w-full w-[clamp(7rem,5.6rem+3vw,9rem)] shrink-0 text-sm font-bold"
      data-cost-name
    >
      HushBox
    </div>
    <div
      class="bg-muted/40 relative flex min-h-8 flex-1 items-center justify-end overflow-hidden rounded-md"
      data-cost-track
    >
      <div
        class="bg-primary absolute inset-y-0 left-0 rounded-md"
        style={`width: ${String(Math.max((hushboxCost / 20) * 100, 5))}%`}
        data-cost-fill
      >
      </div>
      <div class="relative py-1 pr-3 text-right text-xs font-bold" data-cost-value>
        <span class="bg-background" data-cost-ground>
          <span class="bg-muted/40">${formattedCost}/mo · ALL {modelCount}+ models</span>
        </span>
      </div>
    </div>
  </div>
</div>
