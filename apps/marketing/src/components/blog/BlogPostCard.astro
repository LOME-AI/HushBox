---
import { Badge } from '@hushbox/ui/marks';
import { Heading } from '@hushbox/ui/type';
import { getReadingTime, formatPostDate } from '../../lib/blog';
import type { BlogPost } from '../../lib/blog';

interface Props {
  post: BlogPost;
  lead?: boolean;
}

const { post, lead = false } = Astro.props;
const { id: slug, data, body } = post;
const { title, description, author, date, tags } = data;

const formattedDate = formatPostDate(date, 'short');
---

<a
  href={`/blog/${slug}`}
  data-blog-card
  data-tags={tags.join(',')}
  class:list={[
    'border-border bg-card hover:border-brand-red group flex min-w-0 flex-col rounded-xl border-2 transition-colors',
    lead ? 'p-[clamp(1.5rem,1rem+1.6vw,2.25rem)] md:col-span-2' : 'p-6',
  ]}
>
  {
    lead && (
      <span class="mb-3 flex self-start">
        <Badge tone="brand">Latest</Badge>
      </span>
    )
  }

  {
    lead ? (
      <Heading level={3} variant="site-lead">
        <span class="group-hover:text-brand-red-hover wrap-break-word transition-colors">
          {title}
        </span>
      </Heading>
    ) : (
      <h3 class="text-brand-red group-hover:text-brand-red-hover text-lg font-semibold wrap-break-word transition-colors">
        {title}
      </h3>
    )
  }

  <p
    class:list={[
      'text-muted-foreground mt-2 font-serif',
      lead
        ? 'line-clamp-3 max-w-176 text-[length:clamp(0.9375rem,0.9rem_+_0.2vw,1.0625rem)] leading-[1.6]'
        : 'line-clamp-2 text-sm',
    ]}
  >
    {description}
  </p>

  <div class="mt-auto pt-4">
    <div class="text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
      <span>{author}</span>
      <span aria-hidden="true">&middot;</span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{getReadingTime(body ?? '')} min read</span>
    </div>

    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <Badge tone="secondary">{tag}</Badge>
          ))}
        </div>
      )
    }
  </div>
</a>
