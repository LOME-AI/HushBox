  "devDependencies": {
    "@hushbox/config": "workspace:*",
    "@hushbox/shared": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "sucrase": "^3.35.1",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "wrangler": "4.134.0"
  }
