default_platform(:ios)

platform :ios do
  desc "Shared: the App Store Connect API key, read from the environment."
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )
  end

  desc "Shared: set up CI keychain, pull signing certs, build the IPA the upload lane sends."
  private_lane :build_ipa do
    setup_ci

    match(
      type: "appstore",
      api_key: asc_api_key,
      readonly: true,
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "HushBox.ipa",
    )
  end

  desc "Build the IPA (no upload). The workflow sweeps it before any upload."
  lane :build do
    build_ipa
  end

  desc "Upload the IPA the build lane wrote to App Store Connect. Pass submit_for_review as true to auto-submit to App Store review (defaults to false, which means TestFlight only)."
  lane :upload do |options|
    submit_for_review = options[:submit_for_review] || false

    upload_to_app_store(
      api_key: asc_api_key,
      ipa: "./build/HushBox.ipa",
      submit_for_review: submit_for_review,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
    )
  end
end
